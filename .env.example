# Application
PORT=8080
DATA_DIR=/data
TZ=Europe/Paris

# Accès optionnel (laisser vide pour désactiver)
AUTH_USER=
AUTH_PASSWORD=

# Services cartographiques locaux (réseau Docker)
GEOCODER_URL=http://nominatim:8080
ROUTER_URL=http://osrm:5000
GEOCODER_TIMEOUT=30
ROUTER_TIMEOUT=30

# Carte (Bouzonville)
MAP_CENTER_LAT=49.292
MAP_CENTER_LON=6.534
MAP_DEFAULT_ZOOM=12
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors

# Dépôt librairie
DEPOT_NAME=L'Evasion
DEPOT_ADDRESS=24 rue de la République, 57320 Bouzonville

# Estimation mode dégradé (si OSRM indisponible)
AVG_SPEED_KMH=30

# Import
MAX_IMPORT_BYTES=1048576

# Mot de passe interne PostgreSQL de Nominatim (réseau Docker uniquement — à changer)
NOMINATIM_PASSWORD=changez-moi

# Extracts OSM (Geofabrik)
OSM_LORRAINE_URL=https://download.geofabrik.de/europe/france/lorraine-latest.osm.pbf
OSM_SAARLAND_URL=https://download.geofabrik.de/europe/germany/saarland-latest.osm.pbf
